+def find_users_by_name(connection: sqlite3.Connection, name: str) -> list[User]:
+    rows = connection.execute(
+        f"SELECT id, email, display_name FROM users WHERE display_name LIKE '%{name}%'"
+    ).fetchall()
+    return [User(*row) for row in rows]
