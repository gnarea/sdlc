{
  "name": "sdlc",
  "private": true,
  "license": "MIT",
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "spellcheck": "cspell lint --no-progress",
    "lint": "markdownlint-cli2",
    "validate:skills": "uv run --locked .github/scripts/validate_skills.py skills",
    "validate:plugin": "claude plugin validate . && claude plugin validate --strict skills && claude plugin validate --strict agents",
    "test:evals": "uv run --locked python -I -B -m unittest discover --start-directory evals/runner --top-level-directory evals/runner"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.317",
    "@cspell/dict-en-common-misspellings": "2.2.6",
    "@cspell/dict-en-gb-ise": "1.0.38",
    "@semantic-release/exec": "7.1.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "cspell": "10.4.0",
    "markdownlint-cli2": "0.24.0",
    "semantic-release": "25.0.9"
  },
  "allowScripts": {
    "@anthropic-ai/claude-code": true
  }
}
