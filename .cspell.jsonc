{
  "version": "0.2",
  "language": "en-GB",
  // The default configuration enables dictionaries of software terms that accept American spellings (e.g., "analyze", "color").
  "loadDefaultConfiguration": false,
  "import": [
    "@cspell/dict-en-gb-ise/cspell-ext.json",
    "@cspell/dict-en-common-misspellings/cspell-ext.json"
  ],
  "files": ["**/*.md"],
  "useGitignore": true,
  "patterns": [
    {
      "name": "fenced-code-block",
      "pattern": "/^([ \\t]*)(`{3,}|~{3,})[^\\n]*\\n[\\s\\S]*?^\\1\\2[ \\t]*$/gm"
    },
    {
      "name": "code-span",
      "pattern": "/(?<!`)(`+)(?!`).*?(?<!`)\\1(?!`)/g"
    },
    {
      "name": "link-destination",
      "pattern": "/(?<=\\]\\()[^)\\s]+/g"
    }
  ],
  "ignoreRegExpList": ["Urls", "Email", "fenced-code-block", "code-span", "link-destination"],
  "overrides": [
    {
      // Names of people, organisations, and works, whose titles keep their American spellings.
      "filename": "CREDITS.md",
      "words": [
        "Agrawal",
        "Awala",
        "Beurer",
        "Breunig",
        "Chawla",
        "Claudes",
        "Debenedetti",
        "Defenses",
        "Edoardo",
        "Garg",
        "GEPA",
        "Gloaguen",
        "Golev",
        "Hamel",
        "Husain",
        "Jaroslawicz",
        "Kellner",
        "Khatri",
        "Kohnfelder",
        "Lakshya",
        "Lindenbauer",
        "Luca",
        "Manveer",
        "Marchand",
        "Naman",
        "Nasr",
        "Optimizing",
        "Postel",
        "Praerit",
        "Prakhar",
        "Relaycorp",
        "Saltzer",
        "segnale",
        "Shangyin",
        "Shankar",
        "Summarization",
        "Thibaud",
        "Vercel",
        "Willison",
        "Xiangyi",
        "Yaron"
      ]
    }
  ],
  "words": [
    "AMQP",
    "backend",
    "backoff",
    "cyclomatic",
    "Datadog",
    "delegator",
    "deserialisers",
    "entrypoints",
    "evals",
    "frontmatter",
    "Grep",
    "greps",
    "Jinja",
    "Jira",
    "keystore",
    "Landlock",
    "loadout",
    "lockfiles",
    "microservices",
    "nono",
    "plugin",
    "plugins",
    "PMBOK",
    "prototyper",
    "pyproject",
    "Redis",
    "refactorings",
    "replaceability",
    "reviewability",
    "ruleset",
    "SDLC",
    "SIGTERM",
    "slugify",
    "subclassing",
    "toml",
    "toolu",
    "unlinkability",
    "unrepresentable",
    "webhook",
    "workstreams",
    "worktree"
  ]
}
